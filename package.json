{
      "name": "goldie-rill-chat",
      "private": true,
      "version": "2.0.1",
      "description": "Goldie Rill`s Chatbox",
      "author": {
            "name": "GoldieRill",
            "email": "carterwayneskhizeine@gmail.com",
            "url": "https://github.com/carterwayneskhizeine"
      },
      "main": "dist-electron/main.js",
      "scripts": {
            "dev": "vite",
            "build": "vite build",
            "preview": "vite preview",
            "electron:dev": "cross-env NODE_ENV=development vite --mode development",
            "electron:build": "npm run prepare-resources && vite build && electron-builder",
            "electron:build:portable": "npm run prepare-resources && vite build && electron-builder --win portable",
            "electron:preview": "vite preview",
            "prepare-resources": "node scripts/prepare-resources.js",
            "lint": "eslint src --ext .js,.jsx",
            "test": "vitest run",
            "test:watch": "vitest",
            "typecheck": "tsc --noEmit"
      },
      "build": {
            "appId": "com.goldie.chat",
            "productName": "Goldie Rill Chat",
            "directories": {
                  "output": "dist-electron",
                  "buildResources": "resources"
            },
            "files": [
                  "dist/**/*",
                  "dist-electron/**/*",
                  "resources/**/*"
            ],
            "extraResources": [
                  {
                        "from": "./resources/",
                        "to": "./",
                        "filter": [
                              "*.ico",
                              "*.icns",
                              "*.png",
                              "*.svg",
                              "*.js"
                        ]
                  }
            ],
            "asar": true,
            "win": {
                  "target": [
                        "nsis",
                        "portable"
                  ],
                  "icon": "resources/favicon.ico",
                  "signingHashAlgorithms": [
                        "sha256"
                  ],
                  "signAndEditExecutable": false,
                  "requestedExecutionLevel": "asInvoker",
                  "artifactName": "GoldieRillChat-Setup-${version}.${ext}",
                  "extraResources": [
                        {
                              "from": "resources/",
                              "to": "resources",
                              "filter": [
                                    "**/*"
                              ]
                        },
                        {
                              "from": "resources/shader-presets/",
                              "to": "shader-presets",
                              "filter": [
                                    "*.json"
                              ]
                        }
                  ]
            },
            "portable": {
                  "artifactName": "GoldieRillChat-Portable-${version}.${ext}"
            },
            "nsis": {
                  "oneClick": false,
                  "perMachine": true,
                  "allowToChangeInstallationDirectory": true,
                  "createDesktopShortcut": true,
                  "createStartMenuShortcut": true,
                  "shortcutName": "GoldieRillChat",
                  "installerIcon": "resources/favicon.ico",
                  "uninstallerIcon": "resources/favicon.ico",
                  "uninstallDisplayName": "GoldieRillChat",
                  "artifactName": "GoldieRillChat-Setup-${version}.${ext}"
            },
            "mac": {
                  "target": "dmg",
                  "icon": "./resources/GoldieRillicon.icns"
            },
            "linux": {
                  "target": "AppImage",
                  "icon": "./resources/GoldieRillicon.png"
            }
      },
      "dependencies": {
            "@monaco-editor/react": "^4.6.0",
            "axios": "^1.8.2",
            "cheerio": "^1.0.0",
            "dexie": "^4.0.11",
            "katex": "^0.16.21",
            "lucide-react": "^0.474.0",
            "monaco-editor": "^0.52.2",
            "pyodide": "^0.27.2",
            "react": "^18.2.0",
            "react-audio-player": "^0.17.0",
            "react-dom": "^18.2.0",
            "react-markdown": "^9.0.3",
            "react-syntax-highlighter": "^15.6.1",
            "react-textarea-autosize": "^8.5.7",
            "rehype-katex": "^7.0.0",
            "rehype-raw": "^7.0.0",
            "rehype-sanitize": "^6.0.0",
            "remark-breaks": "^4.0.0",
            "remark-gfm": "^4.0.0",
            "remark-math": "^6.0.0",
            "three": "^0.174.0",
            "unist-util-visit": "^5.0.0",
            "uuid": "^11.1.0",
            "yet-another-react-lightbox": "^3.21.7",
            "zustand": "^5.0.13"
      },
      "devDependencies": {
            "@eslint/js": "^10.0.1",
            "@testing-library/jest-dom": "^6.9.1",
            "@testing-library/react": "^16.3.2",
            "@types/react": "^18.2.15",
            "@types/react-dom": "^18.2.7",
            "@vitejs/plugin-react": "^4.0.3",
            "autoprefixer": "^10.4.16",
            "cross-env": "^7.0.3",
            "daisyui": "^4.4.19",
            "electron": "^28.0.0",
            "electron-builder": "^24.9.1",
            "eslint": "^10.3.0",
            "eslint-config-prettier": "^10.1.8",
            "eslint-plugin-react": "^7.37.5",
            "eslint-plugin-react-hooks": "^7.1.1",
            "jsdom": "^29.1.1",
            "postcss": "^8.4.32",
            "prettier": "^3.8.3",
            "raw-loader": "^4.0.2",
            "tailwindcss": "^3.3.6",
            "vite": "^4.4.5",
            "vite-plugin-electron": "^0.15.5",
            "vite-plugin-electron-renderer": "^0.14.6",
            "vitest": "^4.1.5"
      }
}
